{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Berechtigungen des Hauptfensters: Dateien nur im Datenordner, Netz nur zur EZB, kein Löschen",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/Higgsfield-Kalkulator"
        },
        {
          "path": "$HOME/Higgsfield-Kalkulator/**"
        }
      ]
    },
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://data-api.ecb.europa.eu/*"
        }
      ]
    }
  ]
}
